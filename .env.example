# Optional local path overrides for the experimental V1 runner.
# Do not put X cookies, bearer tokens, API keys, or passwords in this file.
XGE_XACTIONS_MCP_COMMAND=/Users/0x79de/Documents/Codex/2026-09-02/bun/scripts/xactions-mcp.sh
CODEX_EXEC_BIN=/Users/0x79de/.local/bin/codex
HERMES_BIN=/Users/0x79de/.local/bin/hermes
# V2 worker only: set this per host to the current owned Chrome CDP endpoint.
# Do not paste cookies or tokens here.
# XGE_CDP_WS=ws://127.0.0.1:9222/devtools/browser/<current-id>
# Set to 1/true/yes to fail closed and block V2 writes without editing config.
XGE_PUBLISHER_KILL_SWITCH=0

# XActions credentials are read from macOS Keychain by the wrapper:
#   service=xactions-auth-token
#   service=xactions-csrf-token
